    "██       ██   ██   ██   ██    ██ ██       ██ ██ ",
    "███████   █████    ██   ██    ██  ██     ██   ██"
    ]

return {
    textCodes: textCodes,
    genText: genText, 
    genMultiCodeText:genMultiCodeText,
    logo_luakx: logo_luakx
}